---
import Layout from '../layouts/Layout.astro'
import Button from '../components/Button.astro'
import { localizeUrl } from '../i18n'
import t from '../i18n/it.json'

const nf = t.notFound
---

<Layout
  t={t}
  title={nf.metaTitle}
  description={nf.metaDescription}
>
  <section class="ac-not-found">
    <p class="ac-not-found__eyebrow">404</p>
    <h1 class="ac-not-found__title">{nf.heading}</h1>
    <p class="ac-not-found__text">
      {nf.text}
    </p>
    <Button href={localizeUrl(t.lang)} label={nf.cta} variant="primary" icon="arrow-right" />
  </section>
</Layout>

<style>
  .ac-not-found {
    max-width: 36rem;
    margin: 0 auto;
    padding: var(--ac-spacing-16) var(--ac-container-padding) var(--ac-spacing-24);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ac-spacing-6);
  }

  .ac-not-found__eyebrow {
    font-size: var(--ac-text-sm);
    font-weight: var(--ac-font-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(var(--ac-primary));
    margin: 0;
  }

  .ac-not-found__title {
    margin: 0;
    font-size: var(--ac-text-4xl);
    font-weight: var(--ac-font-extrabold);
    line-height: var(--ac-leading-tight);
    color: var(--ac-text);
  }

  .ac-not-found__text {
    margin: 0;
    font-size: var(--ac-text-lg);
    color: var(--ac-text-muted);
    line-height: var(--ac-leading-relaxed);
  }
</style>
