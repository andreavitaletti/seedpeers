---
import '../styles/globals.css'
import { site } from '../site'
import { localizeUrl, type Translations } from '../i18n'
import LandingSection from './LandingSection.astro'
import ContactIntro from './ContactIntro.astro'
import Input from './Input.astro'
import Textarea from './Textarea.astro'
import Select from './Select.astro'
import Button from './Button.astro'
import { countries } from '../utils/countries'

interface Props {
  t: Translations
}

const { t } = Astro.props
const { contact } = t
const { googleForm } = site
// Without a Google Form URL the form only shows a fake "sent" state
const contactDemoOnly = !googleForm.actionUrl

const f = t.contact.form
const privacyHref = localizeUrl(t.lang, '/privacy')
---

<LandingSection id="contact" class="section ac-section-band--subtle">
  <div class="ac-contact">
    <div class="ac-contact__layout animate-fade-in-up">
    <ContactIntro
      title={contact.title}
      description={contact.description}
      channels={contact.channels}
    />

    <div class="ac-contact__form-wrap">
      <form
        class="ac-contact__form"
        data-contact-form
        {...contactDemoOnly ? { 'data-demo-only': '' } : {}}
        data-google-form-url={googleForm.actionUrl}
        data-google-field-first-name={googleForm.fields.firstName}
        data-google-field-last-name={googleForm.fields.lastName}
        data-google-field-email={googleForm.fields.email}
        data-google-field-diy={googleForm.fields.diy}
        data-google-field-pay={googleForm.fields.pay}
        data-google-field-location={googleForm.fields.location}
        data-google-field-message={googleForm.fields.message}
        data-msg-sending={f.sending}
        data-msg-sent={f.sent}
        data-msg-error={f.error}
      >

         <Input
          label="Email"
          type="email"
          placeholder="jane@company.com"
          name="email"
          required
        />

        <div class="ac-contact__row">
          <Input label={f.firstName} placeholder="Jane" name="firstName" />
          <Input label={f.lastName} placeholder="Doe" name="lastName" />
        </div>

        <Select
          label={f.locationLabel}
          name="location"
          placeholder={f.locationPlaceholder}
          options={countries}
        />

        <div class="ac-contact__row">
          <Select
            label={f.diyLabel}
            name="diy"
            placeholder={f.diyPlaceholder}
            options={f.diyOptions}
          />
          <Select
            label={f.payLabel}
            name="pay"
            placeholder={f.payPlaceholder}
            options={f.payOptions}
          />
        </div>

        <Textarea
          label={f.messageLabel}
          placeholder={f.messagePlaceholder}
          name="message"
          rows={5}
        />

        <Button type="submit" label={f.cta} variant="primary" />

        <p class="ac-contact__privacy">
          {f.privacyText} <a href={privacyHref}>{f.privacyLinkText}</a>.
        </p>
      </form>
    </div>
  </div>
  </div>
</LandingSection>

<style>
  .ac-contact__layout {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--ac-spacing-20);
    align-items: start;
  }

  .ac-contact__form-wrap {
    background: var(--ac-card-bg);
    border: 0.0625rem solid var(--ac-border-color);
    border-radius: var(--ac-rounded-2xl);
    padding: var(--ac-spacing-10);
    box-shadow: var(--ac-shadow-lg);
  }

  .ac-contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--ac-spacing-5);
  }

  .ac-contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ac-spacing-4);
  }

  .ac-contact__row :global(.ac-select-wrapper),
  .ac-contact__row :global(.ac-input-wrapper) {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ac-contact__row :global(.ac-select-wrapper > div),
  .ac-contact__row :global(.ac-input-wrapper > div) {
    margin-top: auto;
  }

  .ac-contact__privacy {
    font-size: var(--ac-text-xs);
    color: var(--ac-text-muted);
    text-align: center;
  }

  .ac-contact__privacy a {
    color: rgb(var(--ac-primary));
    text-decoration: none;
  }

  .ac-contact__privacy a:hover {
    text-decoration: underline;
  }

  @media (max-width: 56.25rem) {
    .ac-contact__layout {
      grid-template-columns: 1fr;
      gap: var(--ac-spacing-12);
    }
  }

  @media (max-width: 30rem) {
    .ac-contact__row {
      grid-template-columns: 1fr;
    }

    .ac-contact__form-wrap {
      padding: var(--ac-spacing-6);
    }
  }
</style>

<script>
  const form = document.querySelector('[data-contact-form]') as HTMLFormElement | null
  form?.addEventListener('submit', async (e) => {
    const googleFormUrl = form.getAttribute('data-google-form-url')
    const msgSending = form.getAttribute('data-msg-sending') || 'Sending...'
    const msgSent = form.getAttribute('data-msg-sent') || 'Message sent!'
    const msgError = form.getAttribute('data-msg-error') || 'Error. Try again.'

    if (googleFormUrl) {
      e.preventDefault()
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
      const originalText = btn ? btn.textContent : 'Send Message'
      if (btn) {
        btn.textContent = msgSending
        btn.disabled = true
      }

      const formData = new FormData(form)
      const googleData = new URLSearchParams()

      const fields = {
        firstName: form.getAttribute('data-google-field-first-name'),
        lastName: form.getAttribute('data-google-field-last-name'),
        email: form.getAttribute('data-google-field-email'),
        diy: form.getAttribute('data-google-field-diy'),
        pay: form.getAttribute('data-google-field-pay'),
        location: form.getAttribute('data-google-field-location'),
        message: form.getAttribute('data-google-field-message'),
      }

      if (fields.firstName) googleData.append(fields.firstName, (formData.get('firstName') as string) ?? '')
      if (fields.lastName) googleData.append(fields.lastName, (formData.get('lastName') as string) ?? '')
      if (fields.email) googleData.append(fields.email, (formData.get('email') as string) ?? '')
      if (fields.diy) googleData.append(fields.diy, (formData.get('diy') as string) ?? '')
      if (fields.pay) googleData.append(fields.pay, (formData.get('pay') as string) ?? '')
      if (fields.location) googleData.append(fields.location, (formData.get('location') as string) ?? '')
      if (fields.message) googleData.append(fields.message, (formData.get('message') as string) ?? '')

      try {
        await fetch(googleFormUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: googleData.toString(),
        })

        if (btn) {
          btn.textContent = msgSent
        }
      } catch (err) {
        console.error('Error submitting form to Google Forms:', err)
        if (btn) {
          btn.textContent = msgError
          btn.disabled = false
          setTimeout(() => {
            btn.textContent = originalText
          }, 3000)
        }
      }
      return
    }

    if (!form.hasAttribute('data-demo-only')) return
    e.preventDefault()
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
    if (btn) {
      btn.textContent = msgSent
      btn.disabled = true
    }
  })
</script>
